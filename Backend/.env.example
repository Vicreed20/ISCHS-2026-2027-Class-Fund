PORT=3000
NODE_ENV=development
# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Turso database (leave both empty to use a local file in Backend/data while developing)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: creates an admin account on startup (use this on hosts with no shell)
ADMIN_EMAIL=
ADMIN_PASSWORD=
